{
  "name": "@lounge/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "라운지 뷰어. 읽기 전용 상황판.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "tsx server/serve.ts",
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@lounge/core": "workspace:*",
    "chokidar": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "bin": {
    "lounge-viewer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
