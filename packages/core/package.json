{
  "name": "@lounge/core",
  "version": "0.1.0",
  "private": true,
  "description": "라운지의 단일 진실 — 타입, 상태, 토큰, 경로 규칙, 파일 입출력.",
  "type": "module",
  "exports": {
    ".": {
